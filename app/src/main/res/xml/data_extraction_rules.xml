<!-- SPEC 14.5: Auto Backup excludes the database and snapshot blobs; settings may back up. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="snapshots/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="file" path="snapshots/" />
    </device-transfer>
</data-extraction-rules>
