<resources>
    <!-- SPEC 9: each insight says what happened, with its number, and what the user can do. -->
    <string name="insight_app_unknown">An app</string>
    <string name="insight_percent_decimal">%1$s%%</string>
    <string name="insight_rate">%1$s %2$s</string>

    <string name="insight_r01_title">%1$s kept the phone awake for %2$s</string>
    <string name="insight_r01_body">Android counts more than %1$s of wakelocks in a day as excessive. Restricting its background use stops most of it.</string>
    <string name="insight_r02_title">One wakelock was held for %1$s</string>
    <string name="insight_r02_body">%1$s held “%2$s” through one session. A lock held that long keeps the processor from sleeping.</string>
    <string name="insight_r03_title">The phone was awake %1$s of the time the screen was off</string>
    <string name="insight_r03_body">The screen was off for %1$s. A phone that sleeps well stays under %2$s; the session shows what woke it.</string>
    <string name="insight_r04_title">Screen-off drain was %1$s</string>
    <string name="insight_r04_body">Your usual rate with the screen off is %1$s. The night report shows where the rest went.</string>
    <string name="insight_r05_title">%1$s woke the phone %2$s times an hour</string>
    <string name="insight_r05_body">%1$s alarms in %2$s with the screen off. Restricting its background use makes them rarer.</string>
    <string name="insight_r06_title">%1$s used location for %2$s with the screen off</string>
    <string name="insight_r06_body">You can limit its location access to while it is in use.</string>
    <string name="insight_r07_title">Weak signal is costing battery</string>
    <string name="insight_r07_body">Signal was weak %1$s of the time and the mobile radio took %2$s of the drain. Coulomb has no setting for this; Wi-Fi calling helps where your carrier offers it.</string>
    <string name="insight_r08_title_wifi">Wi-Fi scanning ran for %1$s</string>
    <string name="insight_r08_title_bluetooth">Bluetooth scanning ran for %1$s</string>
    <string name="insight_r08_body">At least one app kept scanning that long in a day. Background scanning can be turned off in the location settings.</string>
    <string name="insight_r09_title">%1$s held a sensor for %2$s with the screen off</string>
    <string name="insight_r09_body">Its page shows what else it did in that time.</string>
    <string name="insight_r10_title">%1$s ran %2$s background jobs in a day</string>
    <string name="insight_r10_title_abandoned">%1$s left %2$s background jobs unfinished</string>
    <string name="insight_r10_body">A stricter standby bucket lets Android run its jobs less often.</string>
    <string name="insight_r11_title">The battery stayed above %1$s for %2$s while charging</string>
    <string name="insight_r11_body">It peaked at %1$s. Heat during charging ages a battery; taking the case off or using a slower charger keeps it cooler.</string>
    <string name="insight_r12_title">The battery reached %1$s</string>
    <string name="insight_r12_body_app">%1$s was using the most power then. Above %2$s a battery ages quickly.</string>
    <string name="insight_r12_body">Above %1$s a battery ages quickly. Let the phone cool before heavy use or charging.</string>
    <string name="insight_r13_title">Charging was slow: %1$s</string>
    <string name="insight_r13_body">Your usual charger gives %1$s. Check the cable and the port.</string>
    <string name="insight_r14_title">The capacity estimate fell %1$s points</string>
    <string name="insight_r14_body">From %1$s to %2$s within %3$s days. It is an estimate; Health shows its range.</string>
    <string name="insight_r15_title">The battery sat at 100%% for %1$s</string>
    <string name="insight_r15_body">It stayed plugged in after it was full. Battery protection in Samsung\'s settings stops the charge earlier.</string>
    <string name="insight_r16_title">%1$s has not been opened for %2$s days</string>
    <string name="insight_r16_body">Android still keeps it in the active group. A stricter standby bucket limits its background work.</string>
    <string name="insight_r17_title">The phone is not reaching deep Doze</string>
    <string name="insight_r17_body">None of the last %1$s long screen-off stretches reached it. The Doze page lists what can prevent it.</string>
    <string name="insight_r18_title">%1$s uses more since its update</string>
    <string name="insight_r18_body">%1$s in a day against its usual %2$s. Its page shows before and after.</string>
    <string name="insight_r19_title">%1$s of the drain is unattributed</string>
    <string name="insight_r19_body">Android\'s power model assigned %1$s of the measured %2$s to apps and hardware. The rest is real drain the model cannot place; there is nothing to act on.</string>
    <string name="insight_r20_title">Coulomb used %1$s of the battery in a day</string>
    <string name="insight_r20_body">Its own budget is %1$s. Lite mode collects less.</string>

