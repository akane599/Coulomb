    <!-- The plain-language dictionary (SPEC 10.3); each line's source is cited in WakeDictionary. -->
    <string name="drain_meaning_android_wakelocks">Android holds this while it honours a wakelock, an app’s or its own. Partial wakelocks shows whose.</string>
    <string name="drain_meaning_android_display">Android holds this while the screen is on or changing state.</string>
    <string name="drain_meaning_android_broadcasts">Android holds this while it tells apps the screen turned on or off, and while it plays the charging sound or animation.</string>
    <string name="drain_meaning_android_booting">Android holds this until the phone has finished starting.</string>
    <string name="drain_meaning_sensor_service">Android’s sensor service, while it delivers readings from a sensor that wakes the phone.</string>
    <string name="drain_meaning_alarm_timer">The kernel’s alarm timer. When an alarm is due within two seconds, it keeps the phone awake instead of letting it sleep.</string>
    <string name="drain_meaning_wakeup_timer">A timer a process watches, held from when it fires until that process picks it up.</string>
    <string name="drain_meaning_input_device">An input device, such as the touchscreen or a button, held from its input until Android picks it up.</string>
    <string name="drain_meaning_alarm_delivery">Android’s alarm manager, while it delivers this app’s alarms.</string>
    <string name="drain_meaning_job">Android’s job scheduler, while it runs this app’s background work.</string>
    <string name="drain_meaning_sync">Android’s sync manager, while it syncs this app’s account data.</string>
    <string name="drain_meaning_sleep_blocked">The phone tried to sleep and stopped, because the sources named were still keeping it awake.</string>
    <string name="drain_meaning_sleep_interrupted">A wakeup event arrived as the phone tried to sleep, so it stopped. The source named was the last one active.</string>
    <string name="drain_meaning_sleep_aborted">The phone tried to sleep and stopped, for the reason the kernel gives.</string>
    <string name="drain_meaning_interrupt">A hardware interrupt woke the phone from deep sleep; the name is the one its driver gave it.</string>

