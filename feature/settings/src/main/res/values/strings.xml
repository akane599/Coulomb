    <string name="data_archive_delete_title">Delete the history from %1$s?</string>
    <string name="data_archive_delete_body">Only this imported history is deleted. This phone’s own data stays. This can’t be undone.</string>
    <string name="data_said_archive_deleted">Imported history deleted.</string>
    <string name="data_delete">Delete</string>
    <string name="data_delete_about">Deletes everything Coulomb recorded on this phone and every imported history. Settings and permissions stay.</string>
    <string name="data_delete_action">Delete all data</string>
    <string name="data_delete_title">Delete all data?</string>
    <string name="data_delete_body">Every session, snapshot, insight and imported history is deleted, with the Action Center’s log. Settings and permissions stay. Coulomb then restarts and records from now on. This can’t be undone.</string>
    <string name="data_deleting">Deleting…</string>
    <string name="data_said_delete_failed">Couldn’t delete the data, and nothing was removed. Try again.</string>
    <string name="data_delete_blocked_title">Revert your changes first</string>
    <plurals name="data_delete_blocked_body">
        <item quantity="one">%1$s change made through the Action Center is still in force. Deleting its log would leave nothing to revert it with. Revert it in the Action Center first.</item>
        <item quantity="other">%1$s changes made through the Action Center are still in force. Deleting their log would leave nothing to revert them with. Revert them in the Action Center first.</item>
    </plurals>
    <string name="data_delete_blocked_open">Open Action Center</string>
    <string name="settings_alerts_lite">Lite mode does not ring the charge and temperature alarms; your choices are kept for Full mode. The digest still comes with the first reading after its time.</string>
