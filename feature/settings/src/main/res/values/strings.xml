    <string name="data_said_newer">This bundle was written by a newer Coulomb. Update Coulomb on this phone, then import it again.</string>
    <string name="data_said_too_old">This bundle was written by a Coulomb too old to import. Update Coulomb on the other phone and export again.</string>
    <string name="data_said_incomplete">This bundle’s export didn’t finish, so nothing was imported. Export it again on the other phone.</string>
    <string name="data_said_damaged">This bundle is damaged or was edited, so nothing was imported. Export it again on the other phone.</string>
