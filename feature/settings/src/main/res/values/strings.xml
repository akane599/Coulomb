    <string name="settings_breakdown_note">Splits drain by component. It adds a system report at each snapshot, which costs a little battery.</string>
    <!-- The alarms and the digest (SPEC 12.3, 14.4). -->
    <string name="settings_charge_alarm">Alarm at the charge target</string>
    <string name="settings_charge_alarm_note">Sounds once per charge when the level reaches the target.</string>
    <string name="settings_temperature">Battery temperature alarm</string>
    <string name="settings_temperature_note">Alerts when the battery is at least this warm, at most once in 30 minutes. Checked while the phone is awake.</string>
    <string name="settings_temperature_note_off">No alarm at a set temperature. An insight about heat can still notify.</string>
    <string name="settings_alerts">Alerts</string>
    <string name="settings_notifications_off">Notifications are off for Coulomb, so these alerts and the digest can’t be shown.</string>
    <string name="settings_notifications_allow">Allow notifications</string>
    <string name="settings_action_center">Action Center</string>
    <string name="settings_action_center_note">Changes Coulomb can make for you, each shown first and revertible.</string>
    <string name="settings_action_center_open">Open the Action Center</string>
    <!-- SPEC 12.7, 14.4. The note names everything an allowed app can do and read (ADR-0065 §7). -->
    <string name="settings_automation">Automation API</string>
    <string name="settings_automation_note">Apps you allow can ask for a snapshot, set the charge target and re-apply a Doze profile you have applied (while the Action Center is on) or return it to stock. They can read the battery level, drain rates, last night’s report and the names of the three apps that use the most battery.</string>
    <string name="settings_automation_apps">Apps allowed</string>
    <string name="settings_automation_apps_none">None yet. An app asks for the permission “automate Coulomb”, and you allow it in Android’s settings for that app.</string>
    <string name="settings_automation_apps_joined">%1$s, %2$s</string>
    <string name="settings_on">On</string>
    <string name="settings_off">Off</string>
    <string name="settings_digest_title">Insights</string>
    <string name="settings_digest">Daily digest of new insights</string>
    <string name="settings_digest_note">One notification a day at most, from the time below. Heat warnings do not wait for it.</string>
    <string name="settings_digest_note_off">New insights still show on Now.</string>

