    <string name="settings_mode">Monitoring mode</string>
    <string name="settings_mode_full">Full</string>
    <string name="settings_mode_lite">Lite</string>
    <string name="settings_mode_full_note">Coulomb keeps recording while it is closed: live current, exact sessions, the charge and temperature alarms.</string>
    <string name="settings_mode_lite_note">No service runs in the background. Coulomb reads Android’s statistics when you open it and every 6 hours, so every app’s use is still counted. There is no live current, session times are less exact, and the charge and temperature alarms do not ring.</string>
    <string name="settings_sampling">Reading interval while Coulomb is open</string>
    <!-- %1$s: a number of seconds. -->
    <string name="settings_sampling_seconds">%1$s s</string>
    <string name="settings_sampling_note">On battery. Behind another app Coulomb reads every 30 s at most; while charging the interval is fixed.</string>
    <string name="settings_retention">Keep every reading for 60 days</string>
    <string name="settings_retention_note">Otherwise readings become one-minute averages after 14 days. Sessions and daily figures are kept either way.</string>
    <string name="settings_own_use">Coulomb’s own use</string>
    <!-- %1$s: a time, "Thu 2:05 PM". -->
    <string name="settings_own_use_since">Since %1$s, by Android’s estimate. Coulomb’s budget is 0.3%% of the battery a day.</string>
    <string name="settings_own_use_none">Not measured yet. It takes two readings of Android’s statistics.</string>
